# Copy to .env and adjust. Never commit the real .env.

# --- Backend ---
# Local (no Docker) defaults to SQLite; Compose overrides to Postgres.
DATABASE_URL=postgresql+psycopg://loantrust:loantrust@db:5432/loantrust
JWT_SECRET=change-me-in-prod-min-32-chars-required

# AI provider: mock (default, no network) | anthropic
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
AI_TIMEOUT_SECONDS=20

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info

# --- Frontend (build-time) ---
VITE_API_URL=http://localhost:8000
